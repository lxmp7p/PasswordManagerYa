
# адрес для подключения к бд
DB_HOST=postgres

# порт для подключения к бд
DB_PORT= 

# имя пользователя бд
DB_USER=app

# пароль бд
DB_PASSWORD=

# название бд
DB_NAME=

# порт для работы сервера :443
SERVER_PORT=

# JWT-SECRET
JWT_SECRET=MEGASECRETKEY

# КЛЮЧ ШИФРОВАНИЯ ЗАПИСЕЙ AES. EXAMPLE = 01234567890123456789012345678901
ENCRYPTION_KEY= 